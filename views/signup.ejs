<!-- Following structure of class codes -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Contact </title>
    <link rel = "stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <%- include ('projectHeader') %>

<div class ="signupcom" >    
<h1 class = "signupwrite">Sign Up Here!</h1>
<p>Already have an account? <a href="/signin">Sign in</a></p>

<form method="POST" action="/users/signup/submit" class="signup_form" >

    <label for="name">Name</label>
    <input type ="text" name="username" id="username">
    <br></br>
    
    <label for="email">Email</label>
    <input type ="email" name="email" id="email">
    <br></br>

    <label for="password">Password</label>
    <input type ="password" name="password" id="password">
    <br>
    <br>

    <input type="submit" value ="Sign up" id="submitButton" class="submitB">

</form>
</div>

<%- include ('projectfooter') %>
</body>
</html>